# Copy to .env before `docker compose up --build`.
#
# Only SESSION_SECRET has to be set. Everything else has a working default for
# a machine you are playing on yourself.

# 32+ random bytes. Rotating this signs every player out.
#   openssl rand -base64 48
SESSION_SECRET=

# Where the browser reaches the game. Used for the CORS allow-list, for the
# links in login emails, and for the card a shared raid unfurls into on X — so
# it has to be the address people actually type.
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
API_PORT=4000

POSTGRES_USER=ironvow
POSTGRES_PASSWORD=ironvow
POSTGRES_DB=ironvow

# off: the game runs with guest play only and the email buttons say so.
# Switch to smtp and fill in the SMTP_ lines to send real login links.
# (console prints links to the log and is refused in production.)
MAIL_TRANSPORT=off

# The access code players type on the first screen. Set it empty (ACCESS_CODE=)
# to open the game to anyone.
ACCESS_CODE=1010

# The project's own accounts. Shown on the first screen, in SETTINGS, and on
# the card at the end of a shared raid — which is the one page somebody reaches
# without an account, so it is the one that matters most.
#
# Left blank, the first screen still draws the button dimmed and saying SOON,
# and the other two places draw nothing at all. Blank CONTRACT says COMING SOON.
#
# These are baked into the browser bundle at build time, so changing one needs
# `docker compose up -d --build` and not just a restart.
X_URL=https://x.com/your_handle
TELEGRAM_URL=https://t.me/your_channel
CONTRACT=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=IRONVOW <no-reply@example.com>

# Web push. Generate with: npx web-push generate-vapid-keys
# Leave blank and notifications are simply off.
# Leave these blank: the API generates a key pair on first start and keeps it
# in the database. Set them only to bring keys over from another deployment.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Bearer token for /ops/health and /ops/divergence. Unset means those are off,
# not open. 16 characters minimum.
# OPS_TOKEN=
