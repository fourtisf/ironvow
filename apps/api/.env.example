NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://ironvow:ironvow@localhost:5432/ironvow
REDIS_URL=redis://127.0.0.1:6379

WEB_ORIGIN=http://localhost:3000

# 32+ random bytes. Rotating this invalidates every session and login link.
SESSION_SECRET=change-me-to-a-long-random-string

# console writes login links to the log and is refused in production.
MAIL_TRANSPORT=console

# Required when MAIL_TRANSPORT=smtp. Without a host, no login link ever arrives,
# so the server refuses to start rather than dropping mail silently.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=IRONVOW <no-reply@ironvow.example.com>

# Bearer token for /ops/divergence and /ops/health. Unset means those endpoints
# are off, not open. 16 characters minimum.
# OPS_TOKEN=
