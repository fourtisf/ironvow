// IRONVOW — server-authoritative game state.
//
// A player's base lives here and nowhere else. The client renders it and sends
// intent; every number in this schema is written by the server after it
// re-derived the cost or the outcome itself.

generator client {
  provider      = "prisma-client-js"
  // The image the API ships in (Dockerfile: node:22-bookworm-slim). Named
  // explicitly so a client generated on a developer's machine still carries
  // the engine the container needs.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?  @unique
  createdAt DateTime @default(now())

  /// A player who started with one tap and has not attached an email yet.
  /// They are a real player with a real base — this only drives the prompt
  /// asking them to secure the account.
  isGuest Boolean @default(false)

  gold      BigInt @default(900)
  iron      BigInt @default(320)
  trophies  Int    @default(0)
  keepLevel Int    @default(1)

  /// How many jobs this hold can run at once. Starts at two and is hired up
  /// to ten with gold; see STARTING_BUILDERS and builderCost in @ironvow/config.
  builders Int @default(2)

  /// The highest trophy total reached during the running season. A season is
  /// paid on this rather than on the final number, so a bad last night costs
  /// nothing that was already earned. Reset to the post-reset total at close.
  seasonPeak Int @default(0)

  /// Relic shards, earned from clan wars and season closes. The only currency
  /// in the game that is not gold or iron, because gold is what a finished
  /// hold has too much of. See relics.ts in @ironvow/config.
  shards  Int  @default(0)
  /// Relic levels held, by type. A type absent has never been forged.
  relics  Json @default("{}")
  /// Which two are carried. Always RELIC_SLOTS long; entries may be null.
  carried Json @default("[]")

  /// Battle items bought and not yet spent. A JSON column for the same reason
  /// the garrison is one: a handful of counts read and written whole, always
  /// with the player, never queried across. See items.ts in @ironvow/config.
  pouch Json @default("{}")

  /// Troops the clan has given this hold. They spawn as defenders when it is
  /// raided, and they are spent doing it — see garrison.ts in @ironvow/config.
  garrison Json @default("{}")

  /// This player's own invitation code, handed out to bring people in.
  /// Null on holds raised before invitations existed; filled in on first read.
  inviteCode   String?   @unique
  /// Who invited them, if anybody. Set once, at sign-up, and never moved.
  invitedById  String?
  /// When the inviter was paid for them. Null until the invited hold reaches
  /// INVITE_REWARD_KEEP_LEVEL, so a fresh account is worth nothing to a script.
  invitePaidAt DateTime?

  /// Production is lazy: this is the watermark the next read accrues from.
  lastTickAt  DateTime  @default(now())
  shieldUntil DateTime?

  /// The hero. There is exactly one per player, so it lives on this row
  /// rather than in a table of its own.
  heroLevel   Int       @default(1)
  /// When the hero returns after falling. Null means it is ready.
  heroReadyAt DateTime?

  /// War Order counters. Server-incremented, because a quest a client can
  /// report progress on is a quest a client can award itself.
  collected     Int      @default(0)
  trainedTotal  Int      @default(0)
  raids         Int      @default(0)
  wins          Int      @default(0)
  threeStars    Int      @default(0)
  /// Ids of War Orders whose reward has been paid out.
  claimedQuests String[] @default([])

  /// Daily War Orders.
  ///
  /// Which three a player has on a given day is derived from their id and the
  /// day number, not stored — see `dailyOrdersFor`. What has to be stored is
  /// how far they have got today, and that is what these are. `dayKey` is the
  /// UTC day they belong to; the first settle on a new day zeroes them.
  dayKey        Int      @default(0)
  dayCollected  Int      @default(0)
  dayTrained    Int      @default(0)
  dayWins       Int      @default(0)
  dayRaids      Int      @default(0)
  dayStars      Int      @default(0)
  dayThreeStars Int      @default(0)
  dayLootGold   Int      @default(0)
  dayUpgrades   Int      @default(0)
  dailyClaimed  String[] @default([])
  /// Consecutive days the player has opened the game. Raises the daily reward.
  streakDays    Int      @default(0)

  /// The last What's New note this player has read, by its number.
  ///
  /// A new hold is created already caught up — see NEWS_LATEST — because the
  /// alternative is greeting somebody's first minute with seven notes about
  /// things they have never seen. Zero therefore means an account that predates
  /// this column, which is exactly the player the panel is for.
  newsSeen      Int      @default(0)

  buildings  Building[]
  clanSeat   ClanMember?
  clanAsks   ClanRequest[]
  clanPosts  ClanMessage[]
  layouts    Layout[]
  pushSubs   PushSubscription[]
  troops     Troop[]
  queue      TrainJob[]
  raidsMade  Raid[]             @relation("attacker")
  raidsTaken Raid[]             @relation("defender")
  sessions   Session[]
  loginLinks LoginLink[]
  seasons    SeasonResult[]

  @@index([trophies])
  @@index([seasonPeak])
  @@index([invitedById])
}

model Building {
  id       String @id @default(cuid())
  playerId String
  /// keep | mine | forge | store | barr | cannon | tower | wall
  type     String
  gx       Int
  gy       Int
  level    Int    @default(1)
  /// Uncollected production, accrued lazily like the player's own resources.
  stock    Float  @default(0)

  /// When the builder finishes with this building. Null means idle, and a
  /// non-null value is what occupies one of the player's three builders.
  completesAt DateTime?
  /// When the player was told this job finished, so it is announced once.
  notifiedAt  DateTime?
  /// The level this becomes when the timer runs out.
  ///
  /// Null while a brand-new building is still going up, which is how a fresh
  /// build is told apart from an upgrade: the first does not work until it is
  /// finished, the second keeps working at its current level throughout.
  upgradingTo Int?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([playerId, type])
  @@index([playerId, completesAt])
}

/// A saved arrangement of a player's buildings (spec S8.7).
///
/// Stores positions only, never the buildings themselves: a layout applied
/// weeks later must move the base the player has now, not resurrect the one
/// they had then. Ids that no longer exist are skipped on apply.
model Layout {
  id        String   @id @default(cuid())
  playerId  String
  /// defence | farming | war | push. Free text rather than an enum, which is
  /// why adding the last two needed no migration at all.
  slot      String
  name      String
  /// [{ id, gx, gy }] for every building at the moment it was saved.
  positions Json
  savedAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, slot])
  @@index([playerId])
}

/// A browser push endpoint (spec S8.4: notifications for finished builds and
/// incoming raids).
///
/// One row per device, because the same account on a phone and a laptop is two
/// endpoints. A push that comes back 404 or 410 means the browser has thrown
/// the subscription away, and the row goes with it.
model PushSubscription {
  id         String    @id @default(cuid())
  playerId   String
  endpoint   String    @unique
  p256dh     String
  auth       String
  /// Set when the player last had a build or raid pushed to them, so a quiet
  /// period is distinguishable from a broken subscription.
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model Troop {
  id       String @id @default(cuid())
  playerId String
  /// raider | archer | lancer | ram
  type     String
  count    Int    @default(0)
  /// War Lab level for this troop type. Capped by the Lab, which is capped
  /// by the Keep — the same gate as everything else.
  level    Int    @default(1)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, type])
  @@index([playerId])
}

model TrainJob {
  id         String   @id @default(cuid())
  playerId   String
  type       String
  /// Absolute finish time, resolved lazily on read like production.
  finishesAt DateTime
  position   Int

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, position])
}

model Raid {
  id         String  @id @default(cuid())
  attackerId String
  /// Null for a raid against a generated hold.
  ///
  /// Trophy matchmaking cannot always find a real opponent — a new player at
  /// zero trophies on a quiet server has nobody in band — and a RAID button
  /// that does nothing is worse than one that finds a garrison to hit.
  defenderId String?

  /// Drives all RNG in the sim. Stored so a replay reproduces exactly.
  seed        BigInt
  /// Frozen copy of the defender's base. The battle is fought against this,
  /// so the defender rebuilding mid-raid changes nothing.
  snapshot    Json
  /// Ordered deploy commands from the attacker. The only thing the client sends.
  commands    Json?
  /// The warband the attacker had when the raid opened.
  ///
  /// Frozen here rather than read at submit time, because training more troops
  /// mid-raid would otherwise change what a replay is allowed to deploy and the
  /// stored result would stop reproducing.
  army        Json
  /// The hero as it stood when the raid opened: its level, and whether it was
  /// available at all. Frozen for the same reason as the warband.
  hero        Json?
  /// War Lab levels per troop type at the moment the raid opened.
  troopLevels Json?

  /// The pouch the attacker carried in. Frozen for the same reason as the
  /// warband: buying an item mid-raid must not change what a raid already open
  /// is allowed to spend, and a replay has to reach the same limits.
  pouch Json?
  /// Battle items used, in tick order. Null from a raid that used none, and
  /// from every raid recorded before items existed.
  items Json?

  /// Set for a war attack: the war, and the roster seat whose frozen base
  /// was fought. A war raid takes no loot and moves no trophies.
  warId       String?
  warMemberId String?

  status       String    @default("open") // open | resolved | expired
  stars        Int       @default(0)
  destroyedPct Float     @default(0)
  lootGold     BigInt    @default(0)
  lootIron     BigInt    @default(0)
  trophyDelta  Int       @default(0)
  /// Server checksum of the replay. Compared against the client's to spot drift.
  checksum     String?

  /// Opaque token for a replay anybody can watch, or null while it is private.
  ///
  /// Deliberately not the raid id. Sharing one fight must not hand out a key
  /// that can be walked to the next fight, and a token nobody can guess is the
  /// difference between publishing one replay and publishing the table.
  ///
  /// Set by the attacker or the defender, and either of them can take it back:
  /// the row keeps the token so an unshare-then-reshare returns the same link
  /// rather than quietly breaking the one already posted.
  shareId   String?   @unique
  /// Null while private. What `sharedAt` and `shareId` disagree about is the
  /// answer: a token with no date is a link that has been withdrawn.
  sharedAt  DateTime?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  resolvedAt   DateTime?

  attacker Player  @relation("attacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defender Player? @relation("defender", fields: [defenderId], references: [id], onDelete: Cascade)

  @@index([defenderId, createdAt])
  @@index([attackerId, createdAt])
  @@index([attackerId, status])
  @@index([warId])
}

/// One row per client-vs-server disagreement. A spike here means a
/// determinism bug in the simulation, not necessarily a cheat (spec S4.6).
model Divergence {
  id             String   @id @default(cuid())
  raidId         String
  playerId       String
  clientChecksum String
  serverChecksum String
  clientStars    Int?
  serverStars    Int
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie value. The raw token is never stored.
  tokenHash String   @unique
  playerId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([expiresAt])
}

model LoginLink {
  id        String    @id @default(cuid())
  /// SHA-256 of the emailed token.
  tokenHash String    @unique
  email     String
  playerId  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

/// A clan.
///
/// Not in the build document. Added because a base builder with no one to talk
/// to is a single-player game with other people's layouts in it — the thing
/// that keeps players in this genre is the twenty other names in the list.
///
/// Deliberately NOT here: clan wars. A war is a second game mode with its own
/// matchmaking, its own clock, its own attack allocation and its own rewards,
/// and inventing all of that unasked would be a worse answer than saying so.
model Clan {
  id          String   @id @default(cuid())
  name        String   @unique
  /// Short badge text, 2-5 characters. Shown next to a member's name.
  tag         String   @unique
  description String   @default("")
  /// open | request | closed
  joinPolicy  String   @default("open")
  /// Applicants below this are refused. Checked on the server, always.
  minTrophies Int      @default(0)
  /// Index into a small set of procedurally drawn badges.
  badge       Int      @default(0)
  createdAt   DateTime @default(now())
  warWins     Int      @default(0)
  warLosses   Int      @default(0)
  warDraws    Int      @default(0)

  members  ClanMember[]
  requests ClanRequest[]
  messages ClanMessage[]
}

/// One seat in one clan.
///
/// `playerId` is unique, which is the whole membership rule: a player is in at
/// most one clan, enforced by the database rather than by remembering to check.
model ClanMember {
  id       String   @id @default(cuid())
  clanId   String
  playerId String   @unique
  /// leader | elder | member
  role     String   @default("member")
  joinedAt DateTime @default(now())

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([clanId])
}

/// A pending application to a clan whose policy is `request`.
model ClanRequest {
  id        String   @id @default(cuid())
  clanId    String
  playerId  String
  createdAt DateTime @default(now())

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([clanId, playerId])
  @@index([clanId])
}

/// One line of clan chat, or one system line.
///
/// The author's name is copied onto the row rather than joined: a message must
/// still render after the player who wrote it deletes their account, and the
/// name they had at the time is the honest thing to show.
model ClanMessage {
  id         String   @id @default(cuid())
  clanId     String
  playerId   String?
  authorName String
  body       String
  /// chat | system
  kind       String   @default("chat")
  createdAt  DateTime @default(now())

  clan   Clan    @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([clanId, createdAt])
}

/// One clan war. See packages/config/src/war.ts for the rules.
///
/// `clanBId` is null while a clan is searching for an opponent. The rosters
/// and their frozen bases live in WarMember; every attack in WarAttack. Both
/// sides' running scores are denormalised here by the submit route so the
/// sheet is one read.
model ClanWar {
  id        String    @id @default(cuid())
  /// search | challenge | active | done | cancelled
  state     String
  clanAId   String
  clanBId   String?
  size      Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  starsA    Int       @default(0)
  starsB    Int       @default(0)
  pctA      Float     @default(0)
  pctB      Float     @default(0)
  /// a | b | draw, once done.
  outcome   String?
  createdAt DateTime  @default(now())

  members WarMember[]
  attacks WarAttack[]

  @@index([state])
  @@index([clanAId, createdAt])
  @@index([clanBId, createdAt])
}

/// A seat on a war roster, with the base as it stood when the war began.
model WarMember {
  id        String @id @default(cuid())
  warId     String
  clanId    String
  playerId  String
  name      String
  keepLevel Int
  snapshot  Json
  /// Best result anyone got against this base. Kept current by the submit route.
  bestStars Int    @default(0)
  bestPct   Float  @default(0)

  war ClanWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@unique([warId, playerId])
  @@index([warId, clanId])
}

/// One settled war attack.
model WarAttack {
  id               String   @id @default(cuid())
  warId            String
  attackerMemberId String
  defenderMemberId String
  stars            Int
  destroyedPct     Float
  raidId           String   @unique
  createdAt        DateTime @default(now())

  war ClanWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@index([warId, attackerMemberId])
  @@index([warId, defenderMemberId])
}

/// Something a player wrote in REPORT A PROBLEM.
model Feedback {
  id        String   @id @default(cuid())
  playerId  String?
  body      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A ladder window. Exactly one row is open at a time: the one with a null
/// `closedAt`. `index` counts up from 1 and is what the client shows.
model Season {
  id        String    @id @default(cuid())
  index     Int       @unique
  startedAt DateTime  @default(now())
  /// Scheduled, not observed. The next season starts from this instant rather
  /// than from when the worker noticed, so a worker outage cannot walk the
  /// whole schedule forward.
  endsAt    DateTime
  /// Set by the worker, and the lock that makes closing idempotent: the update
  /// that sets it is conditional on it being null.
  closedAt  DateTime?

  results SeasonResult[]

  @@index([closedAt])
}

/// What one player got out of one season. Written once, at the close, and
/// never touched again -- this is the receipt, not a running total.
model SeasonResult {
  id        String   @id @default(cuid())
  seasonId  String
  playerId  String
  /// Placing among everyone who was paid, by peak, ties broken by who got
  /// there first -- the same ordering the live ladder uses.
  rank      Int
  /// The peak this was paid on.
  trophies  Int
  /// Tier id from SEASON_TIERS. Stored rather than recomputed, so retuning the
  /// bands does not rewrite history.
  tier      String
  gold      Int
  iron      Int
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([seasonId, playerId])
  @@index([seasonId, rank])
  @@index([playerId, createdAt])
}

/// One counter, for one thing, on one day.
///
/// Deliberately tiny, and deliberately the *only* thing recorded. Almost every
/// question worth asking after a launch is already answerable from columns the
/// game keeps anyway: how many signed up is Player.createdAt, how many came
/// back is Player.streakDays, how far they got is Player.claimedQuests. What no
/// row anywhere can answer is what happened to the people who never became a
/// player at all — how many opened the door, and how many were turned away by
/// the access code. That is what this table is for.
///
/// No third party, no cookie, no identifier: a name, a day and a number.
model Counter {
  id    String @id @default(cuid())
  /// UTC date, as YYYY-MM-DD. A string because it is only ever grouped on.
  day   String
  name  String
  count Int    @default(0)

  @@unique([day, name])
  @@index([name])
}

/// Server-generated secrets that would otherwise have to be pasted into an
/// environment by hand: the VAPID key pair, so browser push works on a fresh
/// deployment without anyone generating keys.
model ServerSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
