{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "API_PROXY_URL",
        "DATABASE_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "SESSION_SECRET",
        "IRONVOW_CHROMIUM",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "SESSION_SECRET",
        "WEB_ORIGIN",
        "MAIL_TRANSPORT",
        "NEXT_PUBLIC_API_URL",
        "PORT",
        "HOST",
        "COOKIE_DOMAIN"
      ]
    }
  },
  "globalEnv": [
    "NODE_ENV"
  ]
}
